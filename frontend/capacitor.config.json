{
  "appId": "cu.tallaya.app",
  "appName": "TallaYa",
  "webDir": "dist",
  "backgroundColor": "#0d1b2e",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0d1b2e",
      "showSpinner": false
    }
  }
}
